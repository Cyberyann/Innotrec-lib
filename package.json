{
  "name": "innotrec-lib-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend_lib",
    "frontend",
    "doc"
  ],
  "scripts": {
    "build:lib": "npm run build -w @innotrec/ui",
    "build": "npm run build:lib && npm run build -w innotrec-sample-frontend && npm run build -w innotrec-doc",
    "dev:front": "npm run dev -w innotrec-sample-frontend",
    "dev:doc": "npm run dev -w innotrec-doc",
    "test": "npm run test -w @innotrec/ui && npm run test -w innotrec-sample-frontend",
    "test:e2e": "npm run test:e2e -w innotrec-sample-frontend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=20"
  }
}
