# Copy to deploy/.env and change every secret. This file is read by docker compose.

# ---------------------------------------------------------------- public URL
# URL typed in the browser (used for CORS/CSRF and for links inside e-mails)
PUBLIC_URL=http://localhost:8080
DOMAIN=localhost
HTTP_PORT=8080
# true as soon as the site is served over HTTPS
SECURE_COOKIES=false

# ---------------------------------------------------------------- application
APP_NAME=Innotrec Sample
DEFAULT_LOCALE=en
SUPPORT_EMAIL=support@example.com
REQUIRE_EMAIL_VERIFICATION=true
ALLOW_REGISTRATION=true
THROTTLE_BURST=20/second
THROTTLE_SUSTAINED=2000/hour

# ---------------------------------------------------------------- secrets
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
POSTGRES_DB=innotrec
POSTGRES_USER=innotrec
POSTGRES_PASSWORD=change-me-too

# Optional: first administrator created at start-up
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=Change-Me-Admin-42

# ---------------------------------------------------------------- e-mail
# dev: Mailpit (docker compose --profile dev) — prod: smtp+tls://user:password@smtp.provider.com:587
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=Innotrec <noreply@example.com>
MAILPIT_PORT=8025
