# Public values are embedded in the bundle at build time (VITE_ prefix) — never put secrets here.
# API root seen by the browser. Keep "/api" when the front and the API are served by the same proxy.
VITE_API_URL=/api
VITE_APP_NAME=Innotrec Sample
VITE_DEFAULT_LOCALE=en
# Must match REQUIRE_EMAIL_VERIFICATION of the backend
VITE_REQUIRE_EMAIL_VERIFICATION=true

# Development only (not exposed to the browser): Django dev server used by the Vite proxy
BACKEND_URL=http://localhost:8000
