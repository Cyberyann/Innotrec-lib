{
  "name": "innotrec-sample-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:stack": "E2E_STACK=1 playwright test e2e/stack.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@innotrec/ui": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
