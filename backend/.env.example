# ---------------------------------------------------------------- Django
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
TIME_ZONE=Europe/Paris
APP_NAME=Innotrec Sample
SUPPORT_EMAIL=support@example.com

# ---------------------------------------------------------------- Database (shared by all apps)
# postgres://USER:PASSWORD@HOST:PORT/NAME — empty = local sqlite file
DATABASE_URL=postgres://innotrec:innotrec@localhost:5432/innotrec
# Shared cache used for rate limiting (recommended in production)
REDIS_URL=

# ---------------------------------------------------------------- Link with the front-end
# Used to build links inside e-mails (reset password, verify e-mail)
FRONTEND_URL=http://localhost:5173
# Comma-separated list of origins allowed to call the API (CORS + CSRF + origin check)
FRONTEND_ORIGINS=http://localhost:5173
SECURE_COOKIES=false
# Share the session between apps on sub-domains, e.g. .example.com
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=

# ---------------------------------------------------------------- Auth behaviour
REQUIRE_EMAIL_VERIFICATION=true
ALLOW_REGISTRATION=true
THROTTLE_BURST=20/second
THROTTLE_SUSTAINED=2000/hour
# Number of reverse proxies in front of Django (1 behind the nginx of docker-compose)
NUM_PROXIES=0

# ---------------------------------------------------------------- E-mail
# consolemail:// (print in terminal) | smtp://user:pass@host:1025 | smtp+tls://user:pass@smtp.example.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Innotrec <noreply@example.com>
